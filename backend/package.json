{
  "name": "nexotico-hr-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Servicios de servidor para el portal interno de NexoTico.",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "user:set-password": "node src/database/setPassword.js",
    "db:verify": "node src/database/verifyConnection.js",
    "db:mysql:verify": "node src/database/verifyConnection.js",
    "db:supabase:verify": "node src/database/verifySupabase.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "test": "node --test"
  },
  "dependencies": {
    "@google/genai": "^3.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "supertest": "^7.3.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  }
}
