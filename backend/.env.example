# Solo servidor. No copie secretos reales al repositorio ni al frontend.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Genere un secreto aleatorio de al menos 32 caracteres; nunca use este ejemplo como secreto.
JWT_SECRET=
JWT_EXPIRES_IN=1h
DATABASE_URL=postgresql://usuario:contrasena@host:5432/postgres
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

